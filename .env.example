# Copy to .env. Do not commit the real token.
HEALTH_INGEST_TOKEN=replace-with-a-long-random-token
# Optional write-only secret for POST /ingest/hc-webhook and POST /ingest/life-dashboard.
# Must match ^[A-Za-z0-9_-]{32,}$. Unset, too short, or equal to HEALTH_INGEST_TOKEN disables URL auth.
# A token in a URL can leak via proxy logs, history, and Referer, and must not be able to read.
# HEALTH_INGEST_URL_TOKEN=
HEALTH_TIMEZONE=UTC
PORT=8787
HOST=0.0.0.0
# Off by default. Set to true, 1, yes, or on to store each request body.
# HEALTH_STORE_RAW=true
# HEALTH_METRIC_ALLOWLIST=heart_rate,resting_heart_rate
# Prefer these export.xml sourceName values when a metric-day has more than one. Unset keeps the largest total.
# HEALTH_SOURCE_PRIORITY=Apple Watch,iPhone
# Comma-separated Origin values allowed to call /mcp. Empty rejects every request that sends Origin.
# MCP_ALLOWED_ORIGINS=https://example.com
# Health Auto Export on POST /ingest keeps today and yesterday. Older points are dropped.
# INGEST_MAX_AGE_DAYS=1
# JSON ingest body limit in bytes.
# INGEST_MAX_BODY_BYTES=1000000
# Accepted ingest posts per token per UTC hour. 0 disables the limit.
# INGEST_RATE_LIMIT_PER_HOUR=6

# SQLite file used when DATABASE_URL is unset. The Docker image uses /data/health.sqlite.
# SQLITE_PATH=./data/health.sqlite

# Postgres. When this is a postgres URL it takes precedence over SQLITE_PATH.
# DATABASE_URL=postgres://user:password@localhost:5432/health
