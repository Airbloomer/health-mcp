# Plan: free tier; upgrade when a real limit is hit.
# CPU cap is 10 ms per invocation. D1 writes cap is 100000 rows per UTC day.
name = "hmcp-pilot-{{TENANT_ID}}"
main = "health-mcp/src/index.js"
compatibility_date = "{{COMPAT_DATE}}"
account_id = "{{CLOUDFLARE_ACCOUNT_ID}}"
workers_dev = false
preview_urls = false

[vars]
BILLING_TAG = "hmcp-pilot"
TENANT_ID = "{{TENANT_ID}}"
HEALTH_TIMEZONE = "America/Los_Angeles"
HEALTH_STORE_RAW = "false"
HEALTH_METRIC_ALLOWLIST = "dietary_energy,protein,carbohydrates,total_fat,active_energy,basal_energy_burned,step_count,weight_body_mass,body_fat_percentage"

[observability]
enabled = false

[observability.logs]
enabled = false
invocation_logs = false

[[d1_databases]]
binding = "DB"
database_name = "hmcp-pilot-{{TENANT_ID}}"
database_id = "{{D1_ID}}"
migrations_dir = "health-mcp/migrations"

[[routes]]
pattern = "{{TENANT_ID}}.health.airbloomer.com"
custom_domain = true
